# ---------- 构建阶段：Vue3 前端 ----------
FROM node:22-alpine AS build
WORKDIR /app

# 先装依赖（利用缓存）
COPY Frontend/package.json Frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
# lockfile 里缺了 rollup 的 linux-musl 可选依赖（Windows 上生成的），手动补上否则 vite 构建失败
RUN npm install --no-save --no-audit --no-fund @rollup/rollup-linux-x64-musl

# 再拷源码并构建；后端地址通过构建参数注入
COPY Frontend/ ./

ARG VITE_API_URL=http://localhost:8080
ARG VITE_AI_URL=http://localhost:5000/api/chat
ARG VITE_AI_STA_URL=http://localhost:5000/api/chat/instance
ARG VITE_AI_STAD_URL=http://localhost:5000/api/chat/instance
ENV VITE_API_URL=$VITE_API_URL \
    VITE_AI_URL=$VITE_AI_URL \
    VITE_AI_STA_URL=$VITE_AI_STA_URL \
    VITE_AI_STAD_URL=$VITE_AI_STAD_URL

RUN npm run build

# ---------- 运行阶段：nginx 静态托管 ----------
FROM nginx:alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
