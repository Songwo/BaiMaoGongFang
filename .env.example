# 白帽工坊 Docker 一键部署配置
# 使用方法：cp .env.example .env，然后按需修改

# ---- Flask AI 问答需要（不填则 AI 问答不可用，其他功能正常）----
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com

# ---- JWT 密钥（生产环境务必改掉）----
JWT_SECRET=please-change-me-in-production

# ---- 前端构建时注入的后端地址 ----
# 本地一键部署保持默认即可。
# 如果部署到远程服务器，把 localhost 换成服务器 IP/域名后重新构建 frontend：
# VITE_API_URL=http://你的服务器IP:8080
# VITE_AI_URL=http://你的服务器IP:5000/api/chat
# VITE_AI_STA_URL=http://你的服务器IP:5000/api/chat/instance
# VITE_AI_STAD_URL=http://你的服务器IP:5000/api/chat/instance
