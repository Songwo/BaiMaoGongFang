# 白帽工坊 · 部署环境变量模板
# 复制为 deploy/.env 并填值；.env 已被 .gitignore 排除，不得提交。

# ===== PostgreSQL =====
POSTGRES_DB=bmgf
POSTGRES_USER=bmgf
POSTGRES_PASSWORD=

# ===== 后端密钥（与 apps/api/.env.example 对应，均为新值）=====
JWT_SECRET=
JWT_EXPIRATION=86400000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ===== 邮件 =====
MAIL_USERNAME=
MAIL_PASSWORD=

# ===== 靶场 Docker 主机 =====
DOCKER_HOST=tcp://host.docker.internal:2375

# ===== CORS =====
CORS_ALLOWED_ORIGINS=http://localhost
