# 白帽工坊 · 主后端环境变量模板
# 用法：复制为 .env 并填入真实值；.env 已被 .gitignore 排除，不得提交。
# 注意：Spring Boot 默认从「操作系统环境变量 / JVM 系统属性」读取这些占位符，
#       不会自动加载本文件。本地开发可在 IDE 运行配置中设置，或引入 dotenv 方案；
#       生产由 docker-compose 注入（见 P2）。
#
# 标注【需重置】的项：原值已泄露进 git 历史，必须改用全新值，旧值视为已作废。

# ===== JWT =====
# 【需重置】签发/校验所有用户 token 的主密钥，建议 >=32 字节随机串
JWT_SECRET=
# token 有效期（毫秒），默认 24 小时
JWT_EXPIRATION=86400000

# ===== 管理员 =====
ADMIN_USERNAME=admin
# 【需重置】管理员密码的 BCrypt 哈希（用 BCryptPasswordEncoder 生成）
ADMIN_PASSWORD=
ADMIN_ID=

# ===== PostgreSQL（主数据库，JPA 用）=====
POSTGRES_URL=jdbc:postgresql://localhost:5432/bmgf
POSTGRES_USER=bmgf
POSTGRES_PASSWORD=bmgf

# ===== 邮件（SMTP）=====
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=
# 【需重置】SMTP 授权码（原授权码已泄露，需在邮箱后台重新生成）
MAIL_PASSWORD=

# ===== Docker（靶场）=====
DOCKER_HOST=tcp://localhost:2375

# ===== CORS（逗号分隔的允许源）=====
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== 静态资源路径 =====
STATIC_LOCATIONS=file:./uploads/avatars/

# ===== 其它 =====
BMGF_LOGO_URL=
